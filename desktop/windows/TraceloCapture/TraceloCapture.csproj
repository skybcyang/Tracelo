<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TraceloCapture</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.9.0</Version>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../CaptureCore/CaptureCore.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <EmbeddedResource Include="../../Sources/TraceloCapture/Resources/capture.html" LogicalName="Capture.capture.html" />
    <EmbeddedResource Include="../../Sources/TraceloCapture/Resources/capture.css" LogicalName="Capture.capture.css" />
    <EmbeddedResource Include="../../Sources/TraceloCapture/Resources/capture.js" LogicalName="Capture.capture.js" />
    <EmbeddedResource Include="../../Sources/TraceloCapture/Resources/create-task.js" LogicalName="Capture.create-task.js" />
    <EmbeddedResource Include="../../../styles.css" LogicalName="Capture.styles.css" />
  </ItemGroup>
  <Target Name="ExcludeUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <!-- The SDK imports both desktop adapters; this host only uses WinForms. -->
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
  <Target Name="BuildSharedCaptureForm" BeforeTargets="PrepareForBuild">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../../build-form.mjs&quot;" />
  </Target>
</Project>
